__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
.env
.venv
venv/

# The local database: sequence data, rebuildable from the catalog.
/data/

# The catalog holds metadata only; sequence must never land in it.
leishref/data/**/*.fa
leishref/data/**/*.fna
leishref/data/**/*.fasta
leishref/data/**/*.gff
leishref/data/**/*.fai
!leishref/data/**/metadata.yaml

# Test installs should go to /data/, not the package catalog.
# Only version-control the structured catalog groups.
leishref/data/*/
!leishref/data/ncbi/
!leishref/data/ncbi_nucleotide/
!leishref/data/scaffold/
!leishref/data/tritrypdb/
!leishref/data/zenodo/
!leishref/data/custom/

# Legacy working directories, kept out of the way.
NCBI/
TriTryDB68/
MyAssemblies/
Scaffold/
TEST/

# `leishref dev add` stages a genome here for review before `dev publish`; it holds
# real sequence data and is never itself committed - only the resulting
# leishref/data/custom/ metadata.yaml is, as a pull request.
/to_publish_on_zenodo/

# AGP files describe layout but shouldn't be shipped with the package.
AGP/

# Alias-named symlinks created by `leishref link`, anchored to the root so the
# tracked AGP directory is unaffected.
/*.fa
/*.fna
/*.fasta
/*.gff
/*.agp

*.swp
*.swo
.DS_Store

# Claude Code settings and project-specific task tracking
.claude/
TASKS.md
docs/_build/
