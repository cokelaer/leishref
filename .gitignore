__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
.env
.venv
venv/

# The local database: sequence data, rebuildable from the catalog.
/data/

# The catalog holds metadata only; sequence must never land in it.
leishref/data/**/*.fa
leishref/data/**/*.fna
leishref/data/**/*.fasta
leishref/data/**/*.gff
leishref/data/**/*.fai
!leishref/data/**/metadata.yaml

# Legacy working directories, kept out of the way.
NCBI/
TriTryDB68/
MyAssemblies/
Scaffold/

# AGP files describe layout as coordinates, not sequence, so they stay tracked:
# they are what makes a scaffolded assembly reproducible from its parent.
!AGP/
!AGP/*.agp

# Alias-named symlinks created by `leishref link`, anchored to the root so the
# tracked AGP directory is unaffected.
/*.fa
/*.fna
/*.fasta
/*.gff
/*.agp

*.swp
*.swo
.DS_Store
